# Application
APP_NAME=AI Product Analytics & Decision Intelligence Copilot
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=text
API_V1_PREFIX=/api/v1

# Data (relative to the backend working directory)
DATA_DIR=./data
DUCKDB_PATH=./data/product_analytics.duckdb
APP_DB_PATH=./data/app.db
DATA_SEED=42
DATA_START_DATE=2026-05-04
DATA_END_DATE=2026-10-30
DATA_NUM_USERS=5000

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# LLM: deterministic | mock | ollama | openai | auto
LLM_PROVIDER=deterministic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_INPUT_USD_PER_1M=0.15
OPENAI_OUTPUT_USD_PER_1M=0.60

# SQL safety limits
SQL_MAX_ROWS=500
SQL_TIMEOUT_SECONDS=8
SQL_MAX_JOINS=3
SQL_MAX_SUBQUERY_DEPTH=2
SQL_MAX_AST_NODES=250
SQL_MEMORY_LIMIT=512MB
SQL_THREADS=2

# AI bounds
AI_MAX_TOOL_CALLS=6
AI_TOOL_TIMEOUT_SECONDS=20
AI_TOTAL_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=900

# Optional: require this bearer token for /api/v1/admin/* endpoints.
ADMIN_API_TOKEN=
